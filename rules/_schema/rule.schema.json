{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/this-ved-dev/transaction-alert-screener/rules/_schema/rule.schema.json",
  "title": "Rule definition (rules/<id>_<slug>/rule.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "owner",
    "version",
    "mode",
    "key",
    "windows",
    "params",
    "weight",
    "red_flag_ids",
    "budget_per_month",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^r(0[0-9]|1[0-2])$",
      "description": "r01..r12; r00 is the example"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "owner": {
      "type": "string",
      "enum": [
        "vedant",
        "vedanshu",
        "abdul",
        "natalie",
        "example"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump on any change to params or SQL; hits store the version they fired under"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "shadow",
        "off"
      ],
      "description": "shadow = run and record hits, never create alerts"
    },
    "output": {
      "type": "string",
      "enum": [
        "hit",
        "ctr_candidate"
      ],
      "default": "hit",
      "description": "table the engine writes rows to: hit (alert queue) or ctr_candidate (R01's list, reconciled against the core)"
    },
    "key": {
      "type": "string",
      "enum": [
        "customer",
        "account",
        "customer_country",
        "customer_beneficiary",
        "receiver",
        "originator_beneficiary"
      ]
    },
    "windows": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "named look-back windows in days or hours, e.g. {lookback_days: 5}"
    },
    "params": {
      "type": "object",
      "description": "thresholds rendered into rule.sql; every key must appear in the SQL template"
    },
    "profiles": {
      "type": "object",
      "description": "optional seasonal overrides: profile name -> {from: MM-DD, to: MM-DD, params: {...}}",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "to",
          "params"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "contribution to the alert priority score"
    },
    "red_flag_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^RF-[0-9]{3}$"
      }
    },
    "budget_per_month": {
      "type": "integer",
      "minimum": 0,
      "description": "max expected alerts/month at 100k accounts; over budget => mode must be shadow"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "tier_multipliers": {
      "type": "object",
      "description": "threshold multipliers by risk tier; default 1.0/1.0/1.0 (the client's thresholds are flat); editable in the admin console",
      "default": {
        "low": 1.0,
        "medium": 1.0,
        "high": 1.0
      },
      "properties": {
        "low": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "client_definition": {
      "type": "string",
      "description": "the client's own wording of the rule, quoted verbatim, when version 1 encodes it (reply of 2026-11-11)"
    }
  }
}
