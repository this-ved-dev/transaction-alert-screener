# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://screener_app:change-me@db:5432/screener
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
# Where canonical Parquet and reference data live inside the container
SCREENER_DATA_DIR=/data
# Investigator agent. Provider is "stub" everywhere except a bank-approved deployment.
LLM_PROVIDER=stub
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Demo users are seeded only when this is "true" (compose.demo sets it)
SEED_DEMO_USERS=false
